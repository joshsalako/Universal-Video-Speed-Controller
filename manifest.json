{
  "manifest_version": 3,
  "name": "Universal Video Speed Controller",
  "version": "1.0.0",
  "description": "Sets and enforces a default playback speed for HTML5 videos across websites.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Universal Video Speed Controller"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
